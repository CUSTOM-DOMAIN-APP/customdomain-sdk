{
  "name": "customdomain-js",
  "version": "0.5.1",
  "description": "CustomDomain\u2122 SDK: let your users connect their own domain in one click, with DNS records written, ownership verified and TLS issued for them.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CUSTOM-DOMAIN-APP/customdomain-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://customdomain.ai/custom-domains-for-saas",
  "bugs": {
    "url": "https://github.com/CUSTOM-DOMAIN-APP/customdomain-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --format=iife --minify --outfile=dist/customdomain-sdk.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "esbuild": "0.28.1"
  },
  "keywords": [
    "custom-domain",
    "custom-domains",
    "dns",
    "dns-automation",
    "domain-connect",
    "white-label",
    "white-label-domain",
    "byod",
    "saas",
    "multi-tenant",
    "ssl",
    "acme",
    "lets-encrypt",
    "vanity-domain",
    "entri-alternative"
  ]
}
