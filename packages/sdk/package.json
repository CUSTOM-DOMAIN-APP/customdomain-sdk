{
  "name": "customdomain-js",
  "version": "0.5.6",
  "description": "CustomDomain\u2122 SDK: let your users connect their own domain in one click, with DNS records written, ownership verified and TLS issued for them.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CUSTOM-DOMAIN-APP/customdomain-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://customdomain.ai/custom-domains-for-saas",
  "bugs": {
    "url": "https://github.com/CUSTOM-DOMAIN-APP/customdomain-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json --emitDeclarationOnly && esbuild src/index.ts --bundle --format=esm --platform=browser --sourcemap --outfile=dist/index.js && esbuild src/index.ts --bundle --format=cjs --platform=browser --sourcemap --outfile=dist/index.cjs && cp dist/index.d.ts dist/index.d.cts && esbuild src/index.ts --bundle --format=iife --minify --outfile=dist/customdomain-sdk.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "esbuild": "0.28.1"
  },
  "keywords": [
    "custom-domain",
    "custom-domains",
    "dns",
    "dns-automation",
    "domain-connect",
    "white-label",
    "white-label-domain",
    "byod",
    "saas",
    "multi-tenant",
    "ssl",
    "acme",
    "lets-encrypt",
    "vanity-domain",
    "entri-alternative"
  ]
}
