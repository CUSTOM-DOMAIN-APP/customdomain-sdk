{
  "name": "@customdomain/react",
  "version": "0.5.5",
  "description": "React bindings for customdomain-js, the CustomDomain\u2122 SDK: add one-click custom domain setup to your React app with a hook or a component.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CUSTOM-DOMAIN-APP/customdomain-sdk.git",
    "directory": "packages/react"
  },
  "homepage": "https://customdomain.ai/custom-domains-for-saas",
  "bugs": {
    "url": "https://github.com/CUSTOM-DOMAIN-APP/customdomain-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json --emitDeclarationOnly && esbuild src/index.tsx --bundle --packages=external --format=esm --platform=neutral --jsx=automatic --sourcemap --outfile=dist/index.js && esbuild src/index.tsx --bundle --packages=external --format=cjs --platform=neutral --jsx=automatic --sourcemap --outfile=dist/index.cjs && cp dist/index.d.ts dist/index.d.cts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "customdomain-js": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "react": "^19",
    "react-dom": "^19",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.1"
  },
  "keywords": [
    "react",
    "react-hook",
    "custom-domain",
    "custom-domains",
    "dns",
    "dns-automation",
    "white-label",
    "byod",
    "saas",
    "multi-tenant",
    "ssl",
    "entri-alternative"
  ]
}
