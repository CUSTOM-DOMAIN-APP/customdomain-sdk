{
  "name": "@customdomain/react",
  "version": "0.4.1",
  "description": "React wrapper for customdomain-js \u2014 embed one-click custom-domain setup in your React app.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CUSTOM-DOMAIN-APP/customdomain-sdk.git",
    "directory": "packages/react"
  },
  "homepage": "https://customdomain.ai",
  "bugs": {
    "url": "https://github.com/CUSTOM-DOMAIN-APP/customdomain-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "customdomain-js": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "react": "^19",
    "react-dom": "^19",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  },
  "keywords": [
    "react",
    "react-hook",
    "custom-domain",
    "custom-domains",
    "dns",
    "dns-automation",
    "white-label",
    "byod",
    "saas",
    "multi-tenant",
    "ssl",
    "entri-alternative"
  ]
}
